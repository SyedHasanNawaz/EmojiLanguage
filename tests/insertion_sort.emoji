💬 Insertion Sort in EmojiLang

⚙️ insert(arr, val) {
    🔢 res = 📦[]
    🔢 inserted = 0
    🔢 k = 0
    🔁 k < 📏(arr) {
        🤔 inserted == 0 && val < 🔍(arr, k) {
            📥 res = 📦[val]
            inserted = 1
        }
        📥 res = 📦[🔍(arr, k)]
        k = k + 1
    }
    🤔 inserted == 0 {
        📥 res = 📦[val]
    }
    ↩️ res
}

⚙️ insertion_sort(arr) {
    🔢 sorted = 📦[]
    🔢 i = 0
    🔁 i < 📏(arr) {
        sorted = insert(sorted, 🔍(arr, i))
        i = i + 1
    }
    ↩️ sorted
}

🔢 data = 📦[5, 2, 4, 1, 3]
🔢 sorted = insertion_sort(data)
📢 sorted
